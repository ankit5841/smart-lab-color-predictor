# Database: defaults to local SQLite; use PostgreSQL in Docker/production
DATABASE_URL=sqlite:///./smartlab_recipes.db

# Optional: enables live OpenAI Structured Outputs (falls back to deterministic engine if unset/unreachable)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional: set to enforce X-API-Key header on POST /api/v1/predict-recipe and feedback routes
SMARTLAB_API_KEY=

# Logging & CORS
LOG_LEVEL=INFO
CORS_ORIGINS=*
